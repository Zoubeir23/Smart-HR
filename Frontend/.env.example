# URL de l'API backend Django
VITE_API_URL=http://localhost:8000/api/v1
# SSO Google — même client ID que GOOGLE_OAUTH_CLIENT_ID côté backend.
# Laisser vide masque le bouton "Continuer avec Google".
VITE_GOOGLE_CLIENT_ID=
# Sentry DSN (laisser vide en local pour ne pas polluer le monitoring)
VITE_SENTRY_DSN=
# Sentry auth token pour l'upload des source maps en CI/CD (ne jamais committer)
SENTRY_AUTH_TOKEN=
