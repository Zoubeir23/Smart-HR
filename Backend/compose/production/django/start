#!/bin/bash

set -o errexit
set -o pipefail
set -o nounset


python /app/manage.py collectstatic --noinput
python /app/manage.py migrate --noinput
# Le seeding ne doit jamais empêcher l'application de démarrer (|| true), mais
# ses erreurs doivent rester VISIBLES dans les logs : le `2>/dev/null` d'origine
# masquait totalement l'échec, et les comptes de démonstration disparaissaient
# silencieusement (ex. DJANGO_DEMO_PASSWORD manquante) sans aucune trace.
python /app/manage.py seed_demo_data || echo ">>> AVERTISSEMENT : seed_demo_data a échoué (voir l'erreur ci-dessus). L'application démarre quand même."

exec gunicorn config.wsgi \
  --bind 0.0.0.0:5000 \
  --chdir=/app \
  --workers "${WEB_CONCURRENCY:-2}" \
  --timeout 120 \
  --graceful-timeout 30 \
  --keep-alive 5
