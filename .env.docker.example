# ╔══════════════════════════════════════════════════════════════════╗
# ║  Smart-HR Docker Environment Variables - TEMPLATE               ║
# ║  INSTRUCTIONS:                                                   ║
# ║  1. Copy this file to .env.docker                                ║
# ║  2. Fill in your actual API keys and secrets                     ║
# ║  3. NEVER commit .env.docker to Git!                             ║
# ╚══════════════════════════════════════════════════════════════════╝

# ── Django ────────────────────────────────────────────────────────
SECRET_KEY=CHANGE-ME-to-a-random-50-char-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com

# ── Database (must match docker-compose db service) ───────────────
DB_NAME=DB_smart-hr
DB_USER=postgres
DB_PASSWORD=CHANGE-ME-secure-password
DB_HOST=db
DB_PORT=5432

# ── CORS (frontend origin as seen by users) ──────────────────────
CORS_ALLOWED_ORIGINS=http://localhost,https://your-domain.com

# ── Authentification ─────────────────────────────────────────────
# Inscription libre allauth (/accounts/signup/). DOIT rester à False : sinon un
# anonyme se crée un compte au rôle EMPLOYEE et lit l'annuaire du personnel.
DJANGO_ACCOUNT_ALLOW_REGISTRATION=False
# Validité (secondes) des liens de réinitialisation ET d'invitation. 3600 = 1 h.
DJANGO_PASSWORD_RESET_TIMEOUT=3600
# Cookie HttpOnly du refresh token : True uniquement si le site répond en HTTPS.
DJANGO_JWT_COOKIE_SECURE=True
# Mot de passe des comptes de démo — OBLIGATOIRE hors DEBUG (seed_demo_data).
DJANGO_DEMO_PASSWORD=CHANGE-ME-strong-password

# ── SSO Google ───────────────────────────────────────────────────
# Console : https://console.cloud.google.com/apis/credentials
# Laisser vide désactive le bouton "Continuer avec Google".
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Même client ID, exposé au frontend au moment du build Vite.
VITE_GOOGLE_CLIENT_ID=

# ── Zoom API (for training module) ───────────────────────────────
ZOOM_CLIENT_ID=your_zoom_client_id_here
ZOOM_CLIENT_SECRET=your_zoom_client_secret_here
ZOOM_REDIRECT_URI=https://your-domain.com/api/training/zoom/callback/

# ─ Zhipu AI (for HR chatbot) ────────────────────────────
# Get your key from: https://open.bigmodel.cn/
ZHIPU_API_KEY=your_zhipu_api_key_here

# ── OpenAI (for recruitment agent + voice agent) ─────────────────
# Get your key from: https://platform.openai.com/api-keys
# Leave empty to use simulated/mock responses
OPENAI_API_KEY=your_openai_api_key_here

# ── Email SMTP (for recruitment automated emails) ────────────────
# Leave empty to skip email sending (logged instead)
EMAIL_HOST_USER=your_email@example.com
EMAIL_HOST_PASSWORD=your_app_password_here
# Expéditeur affiché dans les emails. Utiliser l'adresse Gmail configurée ci-dessus.
# Si absent, EMAIL_HOST_USER est utilisé automatiquement.
DJANGO_DEFAULT_FROM_EMAIL=Smart HR <your_email@gmail.com>

# ── Qdrant (for voice agent vector DB) ───────────────────────────
# Leave empty = in-memory mode (data lost on restart)
# For persistent: deploy Qdrant container and set URL
QDRANT_URL=
QDRANT_API_KEY=

# ── App Port (frontend exposed port) ─────────────────────────────
APP_PORT=80
