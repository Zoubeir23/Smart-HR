# ╔══════════════════════════════════════════════════════════════════╗
# ║  Smart-HR — Variables d'environnement pour docker-compose.vps.yml ║
# ║  (déploiement Dokploy, celui utilisé par deploy.sh)                ║
# ║  INSTRUCTIONS :                                                    ║
# ║  1. Copier ces clés dans l'onglet "Environment" de l'app Dokploy   ║
# ║     (ou dans un ./.env local si vous lancez docker compose         ║
# ║     directement depuis la racine du dépôt).                        ║
# ║  2. Renseigner vos vraies valeurs.                                 ║
# ║  3. Ne JAMAIS committer un .env rempli.                            ║
# ║                                                                     ║
# ║  Le domaine du panneau Dokploy (ex: dok.djazael.com) est distinct  ║
# ║  du domaine de l'application (SITE_URL / DJANGO_ALLOWED_HOSTS      ║
# ║  ci-dessous) : ne pas confondre les deux.                          ║
# ╚══════════════════════════════════════════════════════════════════╝

# ── Django — Général ──────────────────────────────────────────────
DJANGO_SECRET_KEY=CHANGE_ME_generate_with_python_secrets_token_urlsafe_50
# Domaine réel de l'application (PAS celui du panneau Dokploy).
DJANGO_ALLOWED_HOSTS=smart-hr.tech,www.smart-hr.tech
DJANGO_ADMIN_URL=secureAdminPath1234/
SITE_URL=https://smart-hr.tech

# ── Sécurité / HTTPS ──────────────────────────────────────────────
# À True dès que le domaine répond en HTTPS (Dokploy + Let's Encrypt).
# DJANGO_JWT_COOKIE_SECURE doit toujours suivre la même valeur que
# DJANGO_SECURE_SSL_REDIRECT — sinon le cookie de refresh JWT n'est
# jamais envoyé par le navigateur et la session expire au bout de 30 min.
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True

# ── CORS (origine du frontend telle que vue par le navigateur) ────
CORS_ALLOWED_ORIGINS=https://smart-hr.tech,https://www.smart-hr.tech

# ── Authentification ──────────────────────────────────────────────
# Inscription libre allauth (/accounts/signup/). DOIT rester à False : sinon un
# anonyme se crée un compte au rôle EMPLOYEE et lit l'annuaire du personnel.
DJANGO_ACCOUNT_ALLOW_REGISTRATION=False
# Validité (secondes) des liens de réinitialisation ET d'invitation. 3600 = 1 h.
DJANGO_PASSWORD_RESET_TIMEOUT=3600
# Cookie HttpOnly du refresh token : doit suivre DJANGO_SECURE_SSL_REDIRECT ci-dessus.
DJANGO_JWT_COOKIE_SECURE=True
# Mot de passe des comptes de démo — OBLIGATOIRE hors DEBUG (seed_demo_data).
DJANGO_DEMO_PASSWORD=CHANGE_ME_strong_password

# ── SSO Google ────────────────────────────────────────────────────
# Console : https://console.cloud.google.com/apis/credentials
# "Origines JavaScript autorisées" doit inclure https://smart-hr.tech
# (et https://www.smart-hr.tech le cas échéant). Les "URI de redirection"
# ne sont pas utilisés par notre flux (ID token côté client), inutile de
# les renseigner mais ils peuvent rester en place sans risque.
# Laisser vide désactive simplement le bouton "Continuer avec Google".
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Même valeur que GOOGLE_OAUTH_CLIENT_ID : exposée au frontend au build Vite
# (docker-compose.vps.yml la passe en build arg VITE_GOOGLE_CLIENT_ID).

# ── Email SMTP (Gmail App Password) ───────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DJANGO_DEFAULT_FROM_EMAIL=Smart-HR <noreply@smart-hr.tech>
DJANGO_SERVER_EMAIL=noreply@smart-hr.tech

# ── Base de données PostgreSQL ────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=smart_hr
POSTGRES_USER=smart_hr
POSTGRES_PASSWORD=CHANGE_ME_secure_password

# ── Redis / Celery ─────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_FLOWER_USER=admin
CELERY_FLOWER_PASSWORD=CHANGE_ME_strong_password
WEB_CONCURRENCY=2

# ── IA — Google Gemini (chatbot, analyse CV) ──────────────────────
# Clé : https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── MinIO (stockage S3-compatible : CV, contrats, bulletins) ──────
MINIO_STORAGE_ENABLED=True
MINIO_ENDPOINT_URL=http://minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=smart-hr

# ── Sentry (monitoring erreurs) ───────────────────────────────────
SENTRY_DSN=
VITE_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# ── App Port (port exposé du frontend) ────────────────────────────
APP_PORT=80

# ══════════════════════════════════════════════════════════════════
# Variables présentes dans le code mais NON câblées dans
# docker-compose.vps.yml (Zoom, Qdrant, OpenAI, Firecrawl) — à
# ajouter aux services concernés le jour où ces intégrations sont
# activées en production. Sans effet tant qu'elles ne sont pas
# passées explicitement au service `django` dans le compose file.
# ══════════════════════════════════════════════════════════════════
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=
# ZOOM_REDIRECT_URI=https://smart-hr.tech/api/training/zoom/callback/
# ZHIPU_API_KEY=
# OPENAI_API_KEY=
# QDRANT_URL=
# QDRANT_API_KEY=
