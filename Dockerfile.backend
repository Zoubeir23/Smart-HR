# Smart-HR Backend
FROM python:3.13-slim

# Dépendances système pour psycopg et compilation
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ build-essential libpq-dev python3-dev curl && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Installer uv pour une installation rapide des dépendances
RUN pip install --no-cache-dir uv

# Copier les fichiers de dépendances en premier (optimisation du cache Docker)
COPY Backend/pyproject.toml Backend/uv.lock ./

# Installer les dépendances + gunicorn
RUN uv pip install --system --no-cache . && \
    uv pip install --system --no-cache gunicorn

# Copier tout le code source du backend
COPY Backend/ .

# Copier le script d'entrée
COPY docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

# Créer les dossiers media nécessaires
RUN mkdir -p smart_hr/media/documents smart_hr/media/audio smart_hr/media/cvs staticfiles

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
    CMD curl -sf http://localhost:8000/api/v1/auth/login/ -o /dev/null || exit 1

ENTRYPOINT ["/docker-entrypoint.sh"]

# Gunicorn : 4 workers, timeout 120s pour les appels IA
CMD ["gunicorn", "config.wsgi:application", \
     "--bind", "0.0.0.0:8000", \
     "--workers", "4", \
     "--timeout", "120", \
     "--access-logfile", "-", \
     "--error-logfile", "-"]
